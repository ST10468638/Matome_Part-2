  "components": {
    "schemas": {
      "CategoryRequest": {
        "required": [
          "categoryName",
          "categoryType"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "categoryType": {
            "minLength": 1,
            "pattern": "^(Age|Distance)$",
            "type": "string"
          },
          "minimumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maximumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "distanceKm": {
            "maximum": 9999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "entryFee": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EnrolmentRequest": {
        "required": [
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EventRequest": {
        "required": [
          "city",
          "eventDate",
          "eventName",
          "eventType",
          "province",
          "registrationCloseDate",
          "registrationOpenDate",
          "venue"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 3,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "eventType": {
            "minLength": 1,
            "pattern": "^(Running|Walking|Cycling)$",
            "type": "string"
          },
          "distanceKm": {
            "maximum": 9999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "venue": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "province": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "registrationOpenDate": {
            "type": "string",
            "format": "date-time"
          },
          "registrationCloseDate": {
            "type": "string",
            "format": "date-time"
          },
          "maxParticipants": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EventRouteRequest": {
        "required": [
          "finishLocation",
          "routeName",
          "startLocation"
        ],
        "type": "object",
        "properties": {
          "routeName": {
            "maxLength": 150,
            "minLength": 2,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 9999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "startLocation": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "finishLocation": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "routeUrl": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "role": {
            "minLength": 1,
            "pattern": "^(Organiser|Participant)$",
            "type": "string"
          },
          "organiserInviteCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResultRequest": {
        "required": [
          "resultStatus"
        ],
        "type": "object",
        "properties": {
          "finishTime": {
            "type": "string",
            "format": "date-span",
            "nullable": true
          },
          "overallPosition": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "categoryPosition": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "resultStatus": {
            "minLength": 1,
            "pattern": "^(Finished|DNF|DNS|Disqualified)$",
            "type": "string"
          }
        },
        "additionalProperties": false
